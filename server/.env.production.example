# Server Production Environment Configuration Example
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://mizan_user:<db_password>@cluster.mongodb.net/mizan_production?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_complex_64_character_random_secret_in_production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change_this_to_another_complex_64_character_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=https://mizanpos.com
